# Mismas variables de base de datos que sphere-go
PORT=8090

DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASS=
DB_SSLMODE=prefer      # disable | prefer | require
DB_AUTO_MIGRATE=True   # crea/actualiza la tabla inscripciones_preinscripcion al iniciar

TEMPORADA=2027         # la edad se calcula al 31 de diciembre de este año

# Login del panel de administración (/admin en el front). Sin ADMIN_PASSWORD, el login queda apagado.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Mínimo 32 caracteres, p. ej.: openssl rand -hex 32
# (si falta, se genera uno al iniciar y las sesiones se cierran al reiniciar)
JWT_SECRET=
JWT_HORAS=8            # duración de la sesión del admin

RATE_LIMIT_POR_HORA=20 # envíos por IP y hora (0 = sin límite)
TRUST_PROXY=False      # True si la API está detrás de nginx

SWAGGER_ENABLED=False  # True en dev para tener /swagger/ y /redoc/; False en producción

# Dominio donde está publicado el front-landing (separados por coma)
# CORS_EXTRA_ORIGINS=https://upacallstars.cl,https://www.upacallstars.cl
